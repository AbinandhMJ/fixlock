{
  "name": "@abinandhmj/fixlock",
  "version": "0.4.0",
  "description": "Stop fixed bugs and finished features from coming back. Team roles, owner approvals, AI edit warnings, rules files for every AI coding tool, auto CHANGELOG, Linear/ClickUp/Notion sync.",
  "bin": {
    "fixlock": "bin/fixlock.js"
  },
  "files": [
    "bin",
    "src",
    "docs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/e2e.js && node test/trackers.js",
    "prepublishOnly": "node test/e2e.js && node test/trackers.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "regression",
    "revert",
    "bug-fix",
    "ci",
    "pull-request",
    "code-review",
    "ai-coding",
    "claude-code",
    "codex",
    "git",
    "git-blame",
    "linear",
    "clickup",
    "notion",
    "codeowners",
    "team",
    "cursor",
    "copilot",
    "windsurf",
    "gemini",
    "cline",
    "aider",
    "agents-md",
    "changelog"
  ],
  "author": "Abinandh <abinandhmurukesan@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbinandhMJ/fixlock.git"
  },
  "homepage": "https://abinandhmj.github.io/fixlock/",
  "bugs": {
    "url": "https://github.com/AbinandhMJ/fixlock/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "vitepress": "^1.6.3"
  }
}
